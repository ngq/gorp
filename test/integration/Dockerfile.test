# gorp 集成测试构建镜像
FROM golang:1.26-alpine AS builder

WORKDIR /gorp

# 安装依赖
RUN apk add --no-cache git make

# 复制源码并下载集成测试模块依赖
COPY . ./
RUN cd test/integration && go mod download

# 构建（不需要构建产物，只用于测试）
RUN cd test/integration && go test -c . -o /dev/null

# 测试镜像
FROM golang:1.26-alpine

WORKDIR /gorp

# 安装测试依赖
RUN apk add --no-cache git docker-cli

# 复制源码
COPY --from=builder /gorp /gorp

# 默认命令：运行集成测试
WORKDIR /gorp/test/integration
CMD ["go", "test", "-tags=integration", "-v", "./..."]